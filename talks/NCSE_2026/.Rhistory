# Convert Month to Date format and handle missing values
data_clean <- data %>%
mutate(Month = dmy(Month)) %>%
arrange(Month) %>%
# Fill missing cumulative records with last observation
fill(Cumulative_Records, .direction = "down") %>%
# Fill missing public records with last observation
fill(Public_Records, .direction = "down") %>%
# Remove rows where both values are NA (if any)
filter(!(is.na(Cumulative_Records) & is.na(Public_Records)))
library(tidyr)
# Convert Month to Date format and handle missing values
data_clean <- data %>%
mutate(Month = dmy(Month)) %>%
arrange(Month) %>%
# Fill missing cumulative records with last observation
fill(Cumulative_Records, .direction = "down") %>%
# Fill missing public records with last observation
fill(Public_Records, .direction = "down") %>%
# Remove rows where both values are NA (if any)
filter(!(is.na(Cumulative_Records) & is.na(Public_Records)))
library(tidyverse)
# Convert Month to Date format and handle missing values
data_clean <- data %>%
mutate(Month = dmy(Month)) %>%
arrange(Month) %>%
# Fill missing cumulative records with last observation
fill(Cumulative_Records, .direction = "down") %>%
# Fill missing public records with last observation
fill(Public_Records, .direction = "down") %>%
# Remove rows where both values are NA (if any)
filter(!(is.na(Cumulative_Records) & is.na(Public_Records)))
# Create the plot
p <- ggplot(data_clean, aes(x = Month)) +
geom_line(aes(y = Cumulative_Records, color = "Cumulative Records"), size = 1.2) +
geom_line(aes(y = Public_Records, color = "Public Records (1km res.)"), size = 1.2) +
scale_y_continuous(labels = label_number(scale = 1e-6, suffix = "M")) +
scale_color_manual(values = c("Cumulative Records" = "#1f77b4",
"Public Records (1km res.)" = "#ff7f0e")) +
labs(title = "National Biodiversity Network Trust Records Over Time",
subtitle = "Date: {frame_along}",
y = "Number of Records (Millions)",
x = "Date",
color = "Record Type") +
theme_minimal() +
theme(legend.position = "bottom",
plot.title = element_text(size = 16, face = "bold"),
plot.subtitle = element_text(size = 12),
axis.title = element_text(size = 12),
legend.text = element_text(size = 10)) +
# Add point at current frame
geom_point(aes(y = Cumulative_Records), size = 3, color = "#1f77b4") +
geom_point(aes(y = Public_Records), size = 3, color = "#ff7f0e")
# Create the plot
p <- ggplot(data_clean, aes(x = Month)) +
geom_line(aes(y = Cumulative_Records, color = "Cumulative Records"), linewidth = 1.2) +
geom_line(aes(y = Public_Records, color = "Public Records (1km res.)"), linewidth = 1.2) +
scale_y_continuous(labels = label_number(scale = 1e-6, suffix = "M")) +
scale_color_manual(values = c("Cumulative Records" = "#1f77b4",
"Public Records (1km res.)" = "#ff7f0e")) +
labs(title = "National Biodiversity Network Trust Records Over Time",
subtitle = "Date: {frame_along}",
y = "Number of Records (Millions)",
x = "Date",
color = "Record Type") +
theme_minimal() +
theme(legend.position = "bottom",
plot.title = element_text(size = 16, face = "bold"),
plot.subtitle = element_text(size = 12),
axis.title = element_text(size = 12),
legend.text = element_text(size = 10)) +
# Add point at current frame
geom_point(aes(y = Cumulative_Records), size = 3, color = "#1f77b4") +
geom_point(aes(y = Public_Records), size = 3, color = "#ff7f0e")
# Create the plot
p <- ggplot(data_clean, aes(x = Month)) +
geom_line(aes(y = Cumulative_Records, color = "Cumulative Records"), linewidth = 1.2) +
geom_line(aes(y = Public_Records, color = "Public Records (1km res.)"), linewidth = 1.2) +
scale_y_continuous() +
scale_color_manual(values = c("Cumulative Records" = "#1f77b4",
"Public Records (1km res.)" = "#ff7f0e")) +
labs(title = "National Biodiversity Network Trust Records Over Time",
subtitle = "Date: {frame_along}",
y = "Number of Records (Millions)",
x = "Date",
color = "Record Type") +
theme_minimal() +
theme(legend.position = "bottom",
plot.title = element_text(size = 16, face = "bold"),
plot.subtitle = element_text(size = 12),
axis.title = element_text(size = 12),
legend.text = element_text(size = 10)) +
# Add point at current frame
geom_point(aes(y = Cumulative_Records), size = 3, color = "#1f77b4") +
geom_point(aes(y = Public_Records), size = 3, color = "#ff7f0e")
p
# Create the animation
anim <- p +
transition_reveal(Month) +
view_follow(fixed_y = TRUE)
# Render the animation (this may take a few minutes)
animate(anim,
fps = 10,
duration = 20,
width = 800,
height = 600,
renderer = gifski_renderer("NBN_Trust_Growth.gif"))
# Save the animation
anim_save("NBN_Trust_Growth.gif", animation = anim)
# Render the animation (this may take a few minutes)
animate(anim,
fps = 10,
duration = 20,
width = 800,
height = 600,
renderer = gifski_renderer("NBN_Trust_Growth.gif"))
